# ============================================================
# OpenShopCart API — variables de entorno
# Fuente de verdad: src/config.ts (envSchema)
# [Requerida]  = la API no arranca si falta.
# [Opcional]   = puede omitirse; se usa el default indicado.
# ============================================================

# ---- API ----
# [Opcional] (default: 5000) Se lee en src/main/server.ts, no en config.ts.
PORT=5000

# [Opcional] (default: /api/v1)
API_V1_STR=/api/v1

# [Opcional] (default: local) Valores: local | staging | production.
ENVIRONMENT=local

# [Opcional] (default: true). false: las cuentas se registran ya activas y se
# desactiva la recuperación de contraseña por correo. Las actualizaciones de
# perfil nunca envían correo.
# NOTA: aunque sea "false", GMAIL_USER y GMAIL_APP_PASSWORD SIEMPRE se validan:
#   - GMAIL_USER debe seguir siendo un email válido (use un dummy, p. ej. dummy@example.com)
#   - GMAIL_APP_PASSWORD basta con una letra u otro dummy (mínimo 1 carácter).
EMAIL_SERVICE_ENABLED=true

# ---- JWT ----
# [Requerida] (mínimo 32 caracteres)
ACCESS_TOKEN_SECRET_KEY=replace-with-a-unique-secret-at-least-32-characters
# [Requerida] (mínimo 32 caracteres)
REFRESH_TOKEN_SECRET_KEY=replace-with-another-unique-secret-at-least-32-characters

# [Opcional] (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# [Opcional] (default: 168) Horas (= 7 días)
REFRESH_TOKEN_EXPIRE_HOURS=168
# [Opcional] (default: openshopcart-api)
JWT_ISSUER=openshopcart-api
# [Opcional] (default: openshopcart-web)
JWT_AUDIENCE=openshopcart-web

# ---- CORS ----
# [Requerida] URL válida
FRONTEND_HOST=http://localhost:3000
# [Requerida] URLs separadas por comas
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---- MSSQL ----
# [Requerida]
MSSQL_SERVER=localhost
# [Opcional] (default: 4563)
MSSQL_PORT=4563
# [Requerida]
MSSQL_USER=sa
# [Requerida] (mínimo 7 caracteres)
MSSQL_PASSWORD=replace-with-a-strong-password
# [Requerida]
MSSQL_DB=OpenShopCart

# ---- Cache (Valkey) ----
# [Requerida] valkey://host:puerto o valkeys://host:puerto para TLS
VAL_KEY_URL=valkey://localhost:6379
# [Opcional] (default: 60)
CURRENT_USER_CACHE_TTL_SECONDS=60

# ---- Catálogo ----
# [Opcional] (default: storage/catalog-images) Carpeta (relativa al proceso o
# absoluta) de los binarios de imágenes.
IMAGES_STORAGE_DIR=storage/catalog-images

# ---- Inventario ----
# [Opcional] (default: 60) Segundos entre los ciclos del worker de vencimiento
# de reservas.
RESERVATION_EXPIRY_INTERVAL_SECONDS=60

# ---- Carrito ----
# [Opcional] (default: 15) Días de inactividad para considerar abandonado un
# carrito activo.
CART_ABANDONMENT_INACTIVITY_DAYS=15

# ---- Checkout ----
# [Opcionales] (defaults: 25 / 35) Tarifas planas de envío por zona
# (quetzales, sin IVA).
SHIPPING_RATE_GT_CAPITAL=25
SHIPPING_RATE_GT_DEPARTMENTS=35

# ---- Pagos con tarjeta ----
# [Opcional] (default: true). false: el checkout rechaza el método CARD con
# PAYMENT_METHOD_DISABLED.
CARD_PAYMENT_ENABLED=true

# Con STRIPE_SECRET_KEY real: se cobran PaymentIntents de Stripe (moneda de 3
# letras). Sin ella: el procesador sandbox responde de forma determinista.
# [Opcional] IMPORTANTE: NUNCA dejarla vacía (STRIPE_SECRET_KEY=) — la
# validación falla y la API no arranca. Si no se usa, comentar u omitir la
# línea por completo.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# [Opcional] (default: gtq)
STRIPE_CURRENCY=gtq

# ---- Correo (Gmail SMTP con contraseña de aplicación) ----
# La validación aplica aunque EMAIL_SERVICE_ENABLED=false; deje dummies:
#   - GMAIL_APP_PASSWORD: basta una letra u otro dummy
#   - GMAIL_USER: debe ser un email con formato válido (ej. dummy@example.com)
# [Requerida] Formato email
GMAIL_USER=example@gmail.com
# [Requerida] Mínimo 1 carácter
GMAIL_APP_PASSWORD=replace-with-gmail-app-password
# [Opcional] (default: OpenShopCart)
MAIL_FROM_NAME=OpenShopCart

# ---- Cifrado del outbox ----
# [Requerida] Base64 de exactamente 32 bytes (44 caracteres base64).
OUTBOX_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ---- Administrador inicial (solo lo usa el comando bootstrap) ----
# [Opcional] (default: admin@openshopcart.local)
INITIAL_ADMIN_EMAIL=admin@openshopcart.local
# [Opcional] (default: OpenShopCart-Admin-2026!) Mínimo 8 caracteres.
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
